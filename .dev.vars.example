# کپی کنید به .dev.vars و یک رشته تصادفی حداقل ۳۲ کاراکتری قرار دهید.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# طول عمر نشست ورود به ساعت (اختیاری؛ پیش‌فرض ۱۲)
SESSION_HOURS=12

# اختیاری — برای Fallback: یک مقدار Base64 حاصل از ۳۲ بایت تصادفی، فقط برای محیط محلی.
# نمونهٔ تولید: node -e "process.stdout.write(require('crypto').randomBytes(32).toString('base64'))"
# FALLBACK_ENCRYPTION_KEY=
# توکن‌های محیطی بر توکن رمز‌شدهٔ فرم اولویت دارند؛ مقدار واقعی را commit نکنید.
# TELEGRAM_BOT_TOKEN=
# BALE_BOT_TOKEN=
